# Copy this file to `.env` and fill in real values. The server reads it on
# startup (see server/src/index.ts). Shell env vars still win if both are set.
# `.env` is gitignored.

# --- OAuth client IDs (one-time setup; see docs/oauth-setup.md) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=

# --- Server bind (optional) ---
# PORT=4100
# HOST=127.0.0.1
